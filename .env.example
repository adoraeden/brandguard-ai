# Copy the DATABASE_URL into backend/.env. Keep real credentials out of git.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE
GEMINI_API_KEY=replace-with-server-side-gemini-key

# Comma-separated browser origins allowed to call FastAPI directly.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Optional production FastAPI URL. Vercel deployments can use the configured rewrite.
VITE_API_BASE_URL=
